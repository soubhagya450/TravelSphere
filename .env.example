# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
# Neon PostgreSQL / PostgreSQL Connection URL
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120

# Payment Gateway Configuration (Razorpay / Stripe)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_test_mockkey12345
RAZORPAY_KEY_SECRET=mocksecretkey12345
STRIPE_SECRET_KEY=sk_test_mockkey12345

# Map Configuration (leaflet / google)
MAP_PROVIDER=leaflet
GOOGLE_MAPS_API_KEY=

# Groq AI Chatbot Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
